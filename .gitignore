# Cache do Python (gerado automaticamente a cada execução)
__pycache__/
*.pyc

# Configuração local do Claude Code — não faz parte do app
.claude/

# PDFs/Excel gerados pelo próprio app (regeneráveis a qualquer momento pela tela)
orcamento_app/data/exportados/

# Ambiente virtual, se vier a criar um
.venv/
venv/

# Lixo de sistema operacional
Thumbs.db
desktop.ini

# Chave de API (OpenRouter) — nunca deve ser commitada
Chave.txt

# Credenciais do Google Drive (OAuth2) — nunca deve ser commitado
# (ver orcamento_app/CONFIGURAR_GOOGLE_DRIVE.md)
**/.streamlit/secrets.toml

# Template dos secrets do app. Copie este arquivo para secrets.toml (mesma
# pasta) e preencha com os dados reais — o secrets.toml NUNCA deve ser
# commitado (já está no .gitignore da raiz do repositório).
#
# Passo a passo completo para gerar esses valores:
# ver ../CONFIGURAR_GOOGLE_DRIVE.md
#
# No Streamlit Cloud, não existe este arquivo no servidor — os mesmos
# valores são colados em Settings > Secrets do app, no formato TOML abaixo.
#
# Autenticação via OAuth2 (não Service Account) — contas de serviço não têm
# cota de armazenamento própria em contas Google pessoais, só em Shared
# Drives do Google Workspace. client_id/client_secret vêm do ID do cliente
# OAuth criado no Google Cloud Console (tipo "App para computador");
# refresh_token é gerado uma única vez rodando o fluxo de autorização
# local (ver guia).

[gdrive]
client_id = "SEU_CLIENT_ID.apps.googleusercontent.com"
client_secret = "GOCSPX-sua_client_secret"
refresh_token = "1//seu_refresh_token"
